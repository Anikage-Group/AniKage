PUBLIC_API_URL=api.domain.com

# Anizip API endpoint
PUBLIC_ANIZIP_URL=https://api.ani.zip

# AniList GraphQL endpoint
PUBLIC_ANILIST_URL=https://graphql.anilist.co

# AniList OAuth application credentials.
# Create an app at https://anilist.co/settings/developer
# PUBLIC client id is safe to expose; the secret is server-only (token exchange).
PUBLIC_ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Other sources.
PUBLIC_TENRAI_URL=https://api.tenrai.dev/v1
PUBLIC_JIKAN_URL=https://api.jikan.moe/v4
PUBLIC_KITSU_URL=https://kitsu.io/api/edge

# Official MyAnimeList API + OAuth
# Create an app at https://myanimelist.net/apiconfig
# The client id is public; the secret is server-only (token exchange).
PUBLIC_MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
PUBLIC_MAL_API_URL=https://api.myanimelist.net/v2
PUBLIC_MAL_AUTH_URL=https://myanimelist.net/v1/oauth2/authorize
PUBLIC_MAL_TOKEN_URL=https://myanimelist.net/v1/oauth2/token

# Which metadata sources to use, in order:
#   a = AniList, j = Jikan, t = Tenrai, k = Kitsu, m = MyAnimeList (official API)
# Only the listed sources are queried - "j" means Jikan only.
PUBLIC_SOURCE_ORDER=a,m,j,t,k

# Base URL of the deployed site(for OAuth Callbacks) — must exactly match the OAuth callbacks:
#   {PUBLIC_SITE_URL}/auth/anilist/callback
#   {PUBLIC_SITE_URL}/auth/mal/callback
PUBLIC_SITE_URL=http://localhost:5173

# Public repository shown in the footer's Source Code link.
PUBLIC_SOURCE_CODE_URL=https://github.com/anikage-group/anikage